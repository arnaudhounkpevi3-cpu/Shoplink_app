PORT=5000
# Écoute sur toutes les interfaces (accès mobile en Wi‑Fi) — défaut 0.0.0.0
# HOST=0.0.0.0
# Origines CORS supplémentaires (prod), séparées par des virgules
# CORS_ORIGINS=https://ton-front.vercel.app,https://shoplink.bj
# IMPORTANT: Utilisez un secret JWT fort (min 32 caractères aléatoires)
JWT_SECRET=change-me

# Supabase (remplace state.json)
# IMPORTANT: Ne jamais exposer ces clés dans le code ou le frontend
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# MongoDB Atlas (optionnel - Supabase est utilisé par défaut)
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/shoplink?appName=Cluster0

# FedaPay (optionnel)
# FEDAPAY_SECRET_KEY=sk_sandbox_xxx
# FEDAPAY_PUBLIC_KEY=pk_sandbox_xxx
# FEDAPAY_WEBHOOK_SECRET=wh_sandbox_xxx
# FEDAPAY_ENV=sandbox

# Frontend utilisé dans les liens email, notamment reset-password
# FRONTEND_URL=http://localhost:5173

# Domaine principal utilisé pour construire les URLs publiques des boutiques
# Format public : APP_URL/boutique/slug
# APP_URL=https://shoplink-app.vercel.app

# Compte administrateur séparé du login client
# IMPORTANT: Utilisez un mot de passe fort (min 12 caractères, mélange lettres/chiffres/symboles)
# ADMIN_EMAIL=supportshoplink@gmail.com
# ADMIN_PASSWORD=MotDePasseFort123!
# ADMIN_NAME=Administrateur ShopLink

# Email SMTP pour envoyer les liens de réinitialisation
# Brevo SMTP est recommandé et peut être configuré directement côté Supabase/SMTP.
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USER=votre_login_smtp_brevo
# EMAIL_PASS=votre_cle_smtp_brevo
# EMAIL_FROM="ShopLink" <supportshoplink@gmail.com>

# API Brevo utilisée pour l'email de bienvenue après inscription
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx

# OCR.space pour la validation automatique des paiements (optionnel)
# OCR_SPACE_API_KEY=votre_cle_ocr_space

# NODE_ENV=production (à définir en production)
